# Frontend (Vite) — copy to .env.local
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-PUBLISHABLE-OR-ANON-KEY

# Google Drive Picker (Google Cloud console)
VITE_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=AIza...
# The Google Cloud *project number* (not ID)
VITE_GOOGLE_APP_ID=1234567890
# Optional: hint Google sign-in toward your org domain, e.g. umich.edu
VITE_GOOGLE_HOSTED_DOMAIN=
